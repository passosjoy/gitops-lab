# Copie para /opt/gitops-lab/deploy/.env na VM OCI (ou configure via secrets do pipeline).
APP_IMAGE=ghcr.io/SEU-USUARIO/SEU-REPO/app:latest
APP_VERSION=latest
GIT_SHA=

# PostgreSQL (a aplicação usa Postgres)
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque-esta-senha-forte

# App
FLASK_SECRET_KEY=troque-esta-chave-flask
DB_HOST=postgres
DB_PORT=5432
DB_NAME=oficina
DB_USER=oficina
DB_PASSWORD=troque-esta-senha-forte
DATABASE_URL=postgresql+psycopg://oficina:troque-esta-senha-forte@postgres:5432/oficina
APP_ENV=lab
OTEL_SERVICE_NAME=oficina-lanternagem-do-rasta
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc
ENABLE_LAB_ENDPOINTS=true
LOG_LEVEL=INFO
